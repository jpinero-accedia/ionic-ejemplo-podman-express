// vim: ft=javascript ts=3 sw=3 noet:

configureOptimizedRC() {

    this.obj = {

        /**
         * Activa auditoría de seguridad.
         * En modo seguro debe estar en true.
         */
        audit: true,

        /**
         * Ejecuta los scripts de instalación en primer plano.
         * Permite ver qué ocurre si algo se queda colgado.
         */
        "foreground-scripts": true,

        /**
         * Timeout reducido para evitar esperas innecesarias.
         * El valor por defecto (5 minutos) es excesivo.
         */
        "fetch-timeout": 10000,

        /**
         * No instalar automáticamente peerDependencies.
         * El usuario debe decidir qué versiones usar.
         */
        omit: "peer",

        /***************** CHILD SAFE MODE ***************/
        /**
         * Evita ejecutar scripts de instalación.
         * Protege el entorno si los niños tocan algo.
         */
        "ignore-scripts": true,

        /**
         * Impide modificar dependencias.
         * Garantiza que nada se rompa accidentalmente.
         */
        "read-only": true,

        /****************** JMA ***********************/
        /**
         * Crear enlaces simbólicos para los ejecutables de los paquetes.
         */
        "bin-links": true,

        /**
         * Permite saltarse el 2FA en ciertos comandos.
         */
        "bypass-2fa": true,

        /**
         * Editor por defecto para operaciones que lo requieran.
         */
        editor: "code",

        /**
         * Formato más legible para logs de paquetes.
         */
        "format-package-log": true,

        /**
         * Ruta al binario de git.
         */
        git: "git",

        /**
         * Crear tags de git al versionar paquetes.
         */
        "git-tag-version": true,

        /**
         * No instalar paquetes globalmente.
         */
        global: false,

        /**
         * Instalar usando enlaces simbólicos (ideal para contenedores).
         */
        "install-links": true,

        /**
         * Estrategia de instalación recomendada para Podman + xnpm.
         * Usa un store interno y enlaces simbólicos.
         */
        "install-strategy": "linked",

        /**
         * Salida en formato JSON.
         */
        json: true,

        /**
         * No usar el comportamiento legacy de peerDependencies.
         */
        "legacy-peer-dependencies": false,

        /**
         * Crear enlaces simbólicos al instalar dependencias.
         */
        link: true,

        /**
         * Instalar dependencias en el proyecto actual.
         */
        location: "project",

        /**
         * Versión del lockfile.
         */
        "lockfile-version": 3,

        /**
         * Nivel de logs reducido.
         */
        loglevel: "warn",

        /**
         * Salida parseable para herramientas externas.
         */
        parseable: true,

        /**
         * Reconstruir bundles cuando sea necesario.
         */
        "rebuild-bundle": true,

        /**
         * Guardar dependencias por defecto.
         */
        save: true,

        /**
         * Guardar bundles de dependencias.
         */
        "save-bundle": true,

        /**
         * Guardar dependencias de desarrollo.
         */
        "save-dev": true,

        /**
         * Guardar dependencias opcionales.
         */
        "save-optional": true,

        /**
         * Guardar peerDependencies explícitamente.
         */
        "save-peer": true,

        /**
         * Prefijo para versiones guardadas (^ = rango compatible).
         */
        "save-prefix": "^",

        /**
         * Shell por defecto para ejecutar scripts.
         */
        "script-shell": "/usr/bin/zsh",

        /**
         * Shell por defecto del sistema.
         */
        shell: "/usr/bin/zsh"
    };

    /**
     * Avisar si el usuario tiene un proxy configurado,
     * ya que puede causar bloqueos silenciosos.
     */
    if (this.config?.proxy) {
        log.warn("Usando un proxy ==>", this.config.proxy);
    }
}
